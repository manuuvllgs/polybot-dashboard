# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore — nunca se sube.

# --- Telegram (ya configurado en tu .env actual) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polymarket CLOB (dinero real) ---
# Tu private key de MetaMask SIN el prefijo 0x.
# En MetaMask: click en los 3 puntos → Account details → Show private key.
POLYMARKET_PRIVATE_KEY=

# Tu address de Polymarket (la proxy wallet). NO es la de MetaMask.
# Para encontrarla: entra en polymarket.com, click en tu avatar arriba a la
# derecha, "Profile", y copia la dirección 0x... que aparece como tu wallet.
POLYMARKET_FUNDER=
